// RupAI Phase 1 database (Jira RP1). One model per prototype form; column names follow the form
// fields (camelCase in code, snake_case in the database through @map / @@map).
//
// Every business table carries the audit columns created_at/by, updated_at/by and deleted_at/by
// (soft delete, RP1-9). Migrations: `npm run migrate:new -- --name <x>`, review the SQL, then
// `npm run migrate:dev`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// Models are added story by story.

// ---------------------------------------------------------------------------------------------
// RP1-8 Login. No roles in Phase 1 (RP1-L).
// ---------------------------------------------------------------------------------------------

model User {
  id           String    @id @db.Char(26)
  name         String    @db.VarChar(120)
  username     String    @unique @db.VarChar(60)
  email        String?   @unique @db.VarChar(160)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// active | inactive
  status       String    @default("active") @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

/// A refresh token, stored as its SHA-256 hash. Rotated on every refresh; revoked on logout.
model RefreshToken {
  id        String    @id @db.Char(26)
  userId    String    @map("user_id") @db.Char(26)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------------------------
// RP1-9 Edit log. One row per create / update / delete / restore of any record, with the data
// before and after, so earlier values can always be seen.
// ---------------------------------------------------------------------------------------------

model RecordHistory {
  id        String   @id @db.Char(26)
  resource  String   @db.VarChar(60)
  recordId  String   @map("record_id") @db.Char(26)
  /// create | update | delete | restore
  action    String   @db.VarChar(20)
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  changedBy String   @map("changed_by") @db.Char(26)
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([resource, recordId, changedAt])
  @@map("record_history")
}

// ---------------------------------------------------------------------------------------------
// RP1-10 Files. Uploaded once, then a record keeps the file id in its own form field.
// ---------------------------------------------------------------------------------------------

model StoredFile {
  id         String   @id @db.Char(26)
  name       String   @db.VarChar(255)
  type       String   @db.VarChar(100)
  size       Int
  /// Path under UPLOAD_DIR.
  storageKey String   @map("storage_key") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String   @map("created_by") @db.Char(26)

  @@map("stored_files")
}

// ---------------------------------------------------------------------------------------------
// RP1-12 A.1 Estate Profile (EstateProfile.jsx, estateProfileData.js).
// ---------------------------------------------------------------------------------------------

model Estate {
  id                 String    @id @db.Char(26)
  // Estate Basic Information
  estateName         String    @map("estate_name") @db.VarChar(255)
  /// Unique among estates that are not deleted (checked by the CRUD kit).
  estateCode         String    @map("estate_code") @db.VarChar(255)
  establishedYear    Int?      @map("established_year")
  companyOwner       String?   @map("company_owner") @db.VarChar(255)
  /// estateTypes value: company_owned | private_estate | government_estate
  estateType         String    @map("estate_type") @db.VarChar(60)
  /// estateCategories value: large_estate | medium_estate | small_estate
  estateCategory     String    @map("estate_category") @db.VarChar(60)
  address            String?   @db.Text
  policeStation      String?   @map("police_station") @db.VarChar(255)
  district           String?   @db.VarChar(255)
  /// The administrative division (Rangpur, …), not an estate division (A.2).
  division           String?   @db.VarChar(255)
  country            String?   @db.VarChar(255)
  zipCode            String?   @map("zip_code") @db.VarChar(255)
  phone              String?   @db.VarChar(20)
  email              String?   @db.VarChar(160)
  website            String?   @db.VarChar(255)
  // Estate Overview (acres and counts)
  totalLandArea      Decimal   @map("total_land_area") @db.Decimal(12, 2)
  teaArea            Decimal   @map("tea_area") @db.Decimal(12, 2)
  nonTeaArea         Decimal?  @map("non_tea_area") @db.Decimal(12, 2)
  totalFieldBlock    Int?      @map("total_field_block")
  totalDivision      Int?      @map("total_division")
  totalSection       Int?      @map("total_section")
  totalWorker        Int?      @map("total_worker")
  totalFamily        Int?      @map("total_family")
  // Facilities / Amenities: facilityOptions values
  selectedFacilities Json      @map("selected_facilities")
  otherFacilityName  String?   @map("other_facility_name") @db.VarChar(255)
  /// Uploaded file ids (RP1-10).
  estateImages       Json      @map("estate_images")
  // Geo Location
  latitude           Decimal   @db.Decimal(10, 7)
  longitude          Decimal   @db.Decimal(10, 7)
  description        String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  createdBy          String    @map("created_by") @db.Char(26)
  updatedAt          DateTime  @updatedAt @map("updated_at")
  updatedBy          String    @map("updated_by") @db.Char(26)
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by") @db.Char(26)

  managers      EstateManager[]
  divisions     Division[]
  fields        FieldBlock[]
  map           EstateMap?
  lands         LandRecord[]
  nurseries     Nursery[]
  plantings     FieldPlanting[]
  replantings   ReplantingProject[]
  censuses      PlantCensus[]
  bushRegisters BushRegister[]
  mouzas        Mouza[]

  @@index([estateCode])
  @@index([deletedAt, createdAt])
  @@map("estates")
}

/// Manager / In-charge Information: one row per block on the page (managerInformation).
model EstateManager {
  id       String  @id @db.Char(26)
  estateId String  @map("estate_id") @db.Char(26)
  position Int
  /// estate_manager | assistant_manager
  type     String  @db.VarChar(40)
  name     String? @db.VarChar(255)
  mobile   String? @db.VarChar(20)
  email    String? @db.VarChar(160)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId, position])
  @@map("estate_managers")
}

// ---------------------------------------------------------------------------------------------
// RP1-13 A.2 Division & Section (DivisionAndSection.jsx, divisionAndSectionData.js). A field that picks
// another record keeps the form's name (`estate`, `division`) and holds its id; the relation beside it
// is named `…Ref`.
// ---------------------------------------------------------------------------------------------

model Division {
  id           String    @id @db.Char(26)
  estate       String    @map("estate_id") @db.Char(26)
  divisionName String    @map("division_name") @db.VarChar(255)
  /// DIV-<n>; unique within its estate.
  divisionCode String    @map("division_code") @db.VarChar(60)
  totalArea    Decimal   @map("total_area") @db.Decimal(12, 2)
  totalSection Int?      @map("total_section")
  /// Active | Inactive
  status       String    @db.VarChar(20)
  description  String?   @db.VarChar(250)
  /// RP1-51: an employee id (`/options/employees`).
  manager      String?   @db.Char(26)
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by") @db.Char(26)
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by") @db.Char(26)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Char(26)

  estateRef Estate       @relation(fields: [estate], references: [id])
  sections  Section[]
  fields    FieldBlock[]
  nurseries Nursery[]

  @@index([estate, divisionCode])
  @@index([deletedAt, createdAt])
  @@map("divisions")
}

model Section {
  id            String    @id @db.Char(26)
  division      String    @map("division_id") @db.Char(26)
  /// Another section of the same division, or none.
  parentSection String?   @map("parent_section_id") @db.Char(26)
  sectionName   String    @map("section_name") @db.VarChar(255)
  /// SEC-<n>; unique within its division.
  sectionCode   String    @map("section_code") @db.VarChar(60)
  totalArea     Decimal   @map("total_area") @db.Decimal(12, 2)
  /// The prototype's managerOptions name, until employees exist (C.1).
  manager       String?   @db.VarChar(255)
  /// Boundary for the Map & GIS page (A.4): [[latitude, longitude], …]. Seeded; not on the form.
  polygon       Json?
  /// RP1-51: the section's point on the map.
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  /// Active | Inactive
  status        String    @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by") @db.Char(26)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String    @map("updated_by") @db.Char(26)
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by") @db.Char(26)

  divisionRef Division     @relation(fields: [division], references: [id])
  parentRef   Section?     @relation("SectionParent", fields: [parentSection], references: [id])
  subSections Section[]    @relation("SectionParent")
  fields      FieldBlock[]

  @@index([division, sectionCode])
  @@index([parentSection])
  @@index([deletedAt, createdAt])
  @@map("sections")
}

// ---------------------------------------------------------------------------------------------
// RP1-14 A.3 Field/Block Management (FieldOrBlockManagement.jsx, FieldAndBlockManagementData.js).
// ---------------------------------------------------------------------------------------------

model FieldBlock {
  id           String    @id @db.Char(26)
  estate       String    @map("estate_id") @db.Char(26)
  division     String    @map("division_id") @db.Char(26)
  section      String    @map("section_id") @db.Char(26)
  fieldName    String    @map("field_name") @db.VarChar(255)
  /// Unique within its estate.
  fieldCode    String    @map("field_code") @db.VarChar(60)
  /// fieldTypes value: tea_field | nursery | shade_area | road_side | water_body | extension | infrastructure | drain | road_reserve
  fieldType    String    @map("field_type") @db.VarChar(40)
  /// A block inside another field of the same section, or none.
  parentField  String?   @map("parent_field_id") @db.Char(26)
  totalArea    Decimal   @map("total_area") @db.Decimal(12, 2)
  plantedArea  Decimal   @map("planted_area") @db.Decimal(12, 2)
  plantingYear Int       @map("planting_year")
  /// bushTypes value
  bushType     String    @map("bush_type") @db.VarChar(40)
  spacing      String    @db.VarChar(60)
  /// ft
  altitude     Decimal?  @db.Decimal(10, 2)
  /// %
  averageSlope Decimal?  @map("average_slope") @db.Decimal(5, 2)
  /// irrigationSources value
  irrigation   String?   @db.VarChar(40)
  /// soilTypes value
  soilType     String?   @map("soil_type") @db.VarChar(40)
  /// drainage value
  drainage     String?   @db.VarChar(40)
  /// statuses value: active | inactive | under_development | maintenance
  status       String    @db.VarChar(40)
  description  String?   @db.Text
  /// Boundary for the map: [[latitude, longitude], …].
  polygon      Json?
  /// RP1-52: the field's point on the map.
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by") @db.Char(26)
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String    @map("updated_by") @db.Char(26)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Char(26)

  estateRef     Estate              @relation(fields: [estate], references: [id])
  divisionRef   Division            @relation(fields: [division], references: [id])
  sectionRef    Section             @relation(fields: [section], references: [id])
  parentRef     FieldBlock?         @relation("FieldParent", fields: [parentField], references: [id])
  blocks        FieldBlock[]        @relation("FieldParent")
  plantings     FieldPlanting[]
  replantings   ReplantingProject[]
  censuses      PlantCensus[]
  bushRegisters BushRegister[]

  @@index([estate, fieldCode])
  @@index([division])
  @@index([section])
  @@index([parentField])
  @@index([deletedAt, createdAt])
  @@map("fields")
}

// ---------------------------------------------------------------------------------------------
// RP1-15 A.4 Map & GIS Tracking (MapAndGISTracking.jsx, MapAndGISTrackingData.js). No entry form:
// the page reads estates, sections and fields; the estate's own map layers are kept here (seeded).
// Points are [latitude, longitude], as the page's react-leaflet layers take them.
// ---------------------------------------------------------------------------------------------

model EstateMap {
  id             String   @id @db.Char(26)
  estate         String   @unique @map("estate_id") @db.Char(26)
  /// [[lat, lng], …]
  estateBoundary Json     @map("estate_boundary")
  /// [{ id, name, coordinates: [[lat, lng], …] }]
  roads          Json
  /// [{ id, name, coordinates }]
  drains         Json
  /// [{ id, name, coordinates }]
  waterBodies    Json     @map("water_bodies")
  /// [{ id, name, latitude, longitude }]
  buildings      Json
  /// [{ id, name, type, latitude, longitude, icon }]
  markers        Json
  zoom           Int      @default(15)
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String   @map("updated_by") @db.Char(26)

  estateRef Estate @relation(fields: [estate], references: [id])

  @@map("estate_maps")
}

// ---------------------------------------------------------------------------------------------
// RP1-16 A.5 Land & Lease Management (LandAndLeaseManagement.jsx, landAndLeaseManagementData.js).
// The land / lease form, then its lease payments and documents (paymentFormData, documentFormData),
// each linked by `landLeaseId` as the data file names it.
// ---------------------------------------------------------------------------------------------

model LandRecord {
  id                  String    @id @db.Char(26)
  estate              String    @map("estate_id") @db.Char(26)
  /// landLeaseTypes value: leased_in | leased_out | owned | disputed
  landLeaseType       String    @map("land_lease_type") @db.VarChar(40)
  /// landCategories value
  landCategory        String    @map("land_category") @db.VarChar(40)
  landLeaseName       String    @map("land_lease_name") @db.VarChar(255)
  /// Survey / Khatian No
  surveyNo            String    @map("survey_no") @db.VarChar(100)
  /// Plot / Dag No
  plotNo              String    @map("plot_no") @db.VarChar(100)
  /// RP1-54: a mouza of the record's estate (`/options/mouzas?estate=`).
  mouza               String?   @db.Char(26)
  jlNo                String?   @map("jl_no") @db.VarChar(100)
  /// recordTypes value: cs_record | sa_record | rs_record | bs_record
  recordType          String?   @map("record_type") @db.VarChar(40)
  // Owner / Lessor
  ownerName           String    @map("owner_name") @db.VarChar(255)
  fatherOrCompanyName String?   @map("father_or_company_name") @db.VarChar(255)
  ownerMobile         String?   @map("owner_mobile") @db.VarChar(40)
  ownerEmail          String?   @map("owner_email") @db.VarChar(160)
  ownerNidTin         String?   @map("owner_nid_tin") @db.VarChar(60)
  ownerAddress        String?   @map("owner_address") @db.Text
  ownershipRemarks    String?   @map("ownership_remarks") @db.Text
  // Area and status (acres)
  totalArea           Decimal   @map("total_area") @db.Decimal(12, 2)
  usableArea          Decimal?  @map("usable_area") @db.Decimal(12, 2)
  nonUsableArea       Decimal?  @map("non_usable_area") @db.Decimal(12, 2)
  /// landStatuses value: active | inactive | under_process | expired
  landStatus          String    @map("land_status") @db.VarChar(40)
  // Lease period
  acquisitionDate     DateTime  @map("acquisition_date") @db.Date
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime  @map("end_date") @db.Date
  leaseTerm           String?   @map("lease_term") @db.VarChar(60)
  rentAmount          Decimal?  @map("rent_amount") @db.Decimal(14, 2)
  rentPerAcre         Decimal?  @map("rent_per_acre") @db.Decimal(14, 2)
  // Location
  location            String?   @db.VarChar(255)
  gpsArea             String?   @map("gps_area") @db.VarChar(60)
  latitude            Decimal?  @db.Decimal(10, 7)
  longitude           Decimal?  @db.Decimal(10, 7)
  purpose             String?   @db.Text
  /// Land boundary for the map: [[latitude, longitude], …].
  polygon             Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by") @db.Char(26)
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String    @map("updated_by") @db.Char(26)
  deletedAt           DateTime? @map("deleted_at")
  deletedBy           String?   @map("deleted_by") @db.Char(26)

  estateRef Estate         @relation(fields: [estate], references: [id])
  mouzaRef  Mouza?         @relation(fields: [mouza], references: [id])
  payments  LandPayment[]
  documents LandDocument[]

  @@index([estate])
  @@index([deletedAt, createdAt])
  @@map("land_records")
}

model LandPayment {
  id            String    @id @db.Char(26)
  landLeaseId   String    @map("land_record_id") @db.Char(26)
  /// Payment year, e.g. "2026"
  year          String    @db.VarChar(4)
  /// Bangla (Bangabda) year, e.g. "1433"; worked out from dueDate when left empty
  banglaYear    String?   @map("bangla_year") @db.VarChar(4)
  dueDate       DateTime  @map("due_date") @db.Date
  /// BDT
  amount        Decimal   @db.Decimal(14, 2)
  paidAmount    Decimal?  @map("paid_amount") @db.Decimal(14, 2)
  paymentDate   DateTime? @map("payment_date") @db.Date
  /// paymentStatuses value: Paid | Pending | Overdue
  status        String    @db.VarChar(20)
  /// paymentMethods value
  paymentMethod String    @map("payment_method") @db.VarChar(40)
  referenceNo   String?   @map("reference_no") @db.VarChar(100)
  remarks       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by") @db.Char(26)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String    @map("updated_by") @db.Char(26)
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by") @db.Char(26)

  landRef LandRecord @relation(fields: [landLeaseId], references: [id])

  @@index([landLeaseId, year])
  @@index([landLeaseId, banglaYear])
  @@index([deletedAt, createdAt])
  @@map("land_payments")
}

model LandDocument {
  id             String    @id @db.Char(26)
  landLeaseId    String    @map("land_record_id") @db.Char(26)
  documentName   String    @map("document_name") @db.VarChar(255)
  /// documentTypes value
  documentType   String    @map("document_type") @db.VarChar(40)
  documentNumber String?   @map("document_number") @db.VarChar(100)
  issueDate      DateTime? @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  /// Uploaded file id (RP1-10).
  file           String    @db.Char(26)
  remarks        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String    @map("created_by") @db.Char(26)
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String    @map("updated_by") @db.Char(26)
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Char(26)

  landRef LandRecord @relation(fields: [landLeaseId], references: [id])

  @@index([landLeaseId])
  @@index([deletedAt, createdAt])
  @@map("land_documents")
}

// ---------------------------------------------------------------------------------------------
// RP1-17 B.1 Nursery Management (NurseryManagement.jsx, nurseryManagementData.js). The nursery form;
// its beds and stock have no entry form on the page, so they are read-only here (seeded).
// ---------------------------------------------------------------------------------------------

model Nursery {
  id               String    @id @db.Char(26)
  estate           String    @map("estate_id") @db.Char(26)
  division         String    @map("division_id") @db.Char(26)
  nurseryName      String    @map("nursery_name") @db.VarChar(255)
  /// The page's fixed supervisor name, until employees exist (C.1).
  supervisor       String    @db.VarChar(255)
  /// Unique within its estate.
  nurseryCode      String    @map("nursery_code") @db.VarChar(60)
  nurseryType      String    @map("nursery_type") @db.VarChar(60)
  location         String    @db.VarChar(255)
  irrigationSource String    @map("irrigation_source") @db.VarChar(60)
  establishedYear  Int       @map("established_year")
  status           String    @db.VarChar(40)
  totalArea        Decimal   @map("total_area") @db.Decimal(12, 2)
  netUsableArea    Decimal   @map("net_usable_area") @db.Decimal(12, 2)
  /// The "Active" select: the institute (Tea Research Institute | BTB | Private).
  active           String    @db.VarChar(60)
  remarks          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String    @map("created_by") @db.Char(26)
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String    @map("updated_by") @db.Char(26)
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by") @db.Char(26)

  estateRef   Estate         @relation(fields: [estate], references: [id])
  divisionRef Division       @relation(fields: [division], references: [id])
  beds        NurseryBed[]
  stock       NurseryStock[]

  @@index([estate, nurseryCode])
  @@index([deletedAt, createdAt])
  @@map("nurseries")
}

/// nurseryBeds: name, code, clone, area (acre), plants, plantingDate, status.
model NurseryBed {
  id           String   @id @db.Char(26)
  nurseryId    String   @map("nursery_id") @db.Char(26)
  position     Int
  name         String   @db.VarChar(255)
  code         String   @db.VarChar(60)
  clone        String   @db.VarChar(60)
  area         Decimal  @db.Decimal(10, 2)
  plants       Int
  plantingDate DateTime @map("planting_date") @db.Date
  status       String   @db.VarChar(40)

  nursery Nursery @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@index([nurseryId, position])
  @@map("nursery_beds")
}

/// stockInventory: one row per clone / seed.
model NurseryStock {
  id                   String @id @db.Char(26)
  nurseryId            String @map("nursery_id") @db.Char(26)
  position             Int
  clone                String @db.VarChar(60)
  type                 String @db.VarChar(60)
  totalPlants          Int    @map("total_plants")
  availablePlants      Int    @map("available_plants")
  reservedPlants       Int    @map("reserved_plants")
  distributedPlants    Int    @map("distributed_plants")
  /// For the "Distributed This Month" card.
  distributedThisMonth Int    @default(0) @map("distributed_this_month")
  unit                 String @default("Nos") @db.VarChar(20)

  nursery Nursery @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@index([nurseryId, position])
  @@map("nursery_stock")
}

// ---------------------------------------------------------------------------------------------
// RP1-18 B.2 Field Planting (FieldPlanting.jsx, fieldPlantingData.js). Every field of the form; the
// selects keep the page's text values.
// ---------------------------------------------------------------------------------------------

model FieldPlanting {
  id                  String    @id @db.Char(26)
  estate              String    @map("estate_id") @db.Char(26)
  division            String    @map("division_id") @db.Char(26)
  section             String    @map("section_id") @db.Char(26)
  fieldBlock          String    @map("field_id") @db.Char(26)
  plantingYear        Int       @map("planting_year")
  plantingSeason      String    @map("planting_season") @db.VarChar(60)
  plantingDate        DateTime  @map("planting_date") @db.Date
  plantingMethod      String    @map("planting_method") @db.VarChar(60)
  plantSource         String    @map("plant_source") @db.VarChar(60)
  nurseryBed          String?   @map("nursery_bed") @db.VarChar(100)
  cloneVariety        String    @map("clone_variety") @db.VarChar(60)
  plantType           String    @map("plant_type") @db.VarChar(60)
  totalArea           Decimal?  @map("total_area") @db.Decimal(12, 2)
  netPlantableArea    Decimal?  @map("net_plantable_area") @db.Decimal(12, 2)
  previousCrop        String?   @map("previous_crop") @db.VarChar(100)
  rowSpacing          Decimal?  @map("row_spacing") @db.Decimal(6, 2)
  plantSpacing        Decimal?  @map("plant_spacing") @db.Decimal(6, 2)
  pitSize             String?   @map("pit_size") @db.VarChar(60)
  expectedPlants      Int?      @map("expected_plants")
  targetPlants        Int?      @map("target_plants")
  signalPlant         Int?      @map("signal_plant")
  soilType            String    @map("soil_type") @db.VarChar(60)
  soilPH              Decimal?  @map("soil_ph") @db.Decimal(4, 2)
  elevation           Decimal?  @db.Decimal(10, 2)
  slope               String?   @db.VarChar(20)
  drainage            String?   @db.VarChar(60)
  irrigationSource    String?   @map("irrigation_source") @db.VarChar(60)
  irrigationMethod    String?   @map("irrigation_method") @db.VarChar(60)
  basalFertilizer     String?   @map("basal_fertilizer") @db.VarChar(100)
  organicManure       String?   @map("organic_manure") @db.VarChar(100)
  shadeTreePlanned    Boolean?  @map("shade_tree_planned")
  npkAmount           Decimal?  @map("npk_amount") @db.Decimal(12, 2)
  npkUnit             String?   @map("npk_unit") @db.VarChar(20)
  tspAmount           Decimal?  @map("tsp_amount") @db.Decimal(12, 2)
  tspUnit             String?   @map("tsp_unit") @db.VarChar(20)
  mopAmount           Decimal?  @map("mop_amount") @db.Decimal(12, 2)
  mopUnit             String?   @map("mop_unit") @db.VarChar(20)
  fymAmount           Decimal?  @map("fym_amount") @db.Decimal(12, 2)
  fymUnit             String?   @map("fym_unit") @db.VarChar(20)
  shadeTreeSpecies    String?   @map("shade_tree_species") @db.VarChar(100)
  shadeTreeSpacing    String?   @map("shade_tree_spacing") @db.VarChar(60)
  shadeTreeCount      Int?      @map("shade_tree_count")
  shadePurpose        String?   @map("shade_purpose") @db.VarChar(100)
  shadePlantingDate   DateTime? @map("shade_planting_date") @db.Date
  shadeRemarks        String?   @map("shade_remarks") @db.Text
  fieldOfficer        String?   @map("field_officer") @db.VarChar(100)
  assistantSupervisor String?   @map("assistant_supervisor") @db.VarChar(100)
  totalLabour         Int?      @map("total_labour")
  maleLabour          Int?      @map("male_labour")
  femaleLabour        Int?      @map("female_labour")
  labourSource        String?   @map("labour_source") @db.VarChar(60)
  remarks             String?   @db.Text
  /// Uploaded file ids (RP1-10).
  documents           Json
  photos              Json
  /// Plants planted so far; not on the form (seeded; a progress entry comes later).
  plantedPlants       Int       @default(0) @map("planted_plants")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by") @db.Char(26)
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String    @map("updated_by") @db.Char(26)
  deletedAt           DateTime? @map("deleted_at")
  deletedBy           String?   @map("deleted_by") @db.Char(26)

  estateRef Estate     @relation(fields: [estate], references: [id])
  fieldRef  FieldBlock @relation(fields: [fieldBlock], references: [id])

  @@index([estate, plantingYear])
  @@index([fieldBlock])
  @@index([deletedAt, createdAt])
  @@map("field_plantings")
}

// ---------------------------------------------------------------------------------------------
// RP1-19 B.3 Replanting & Gap Filling (ReplantingAndGapFilling.jsx, replantingAndGapFillingData.js).
// One project (replanting_master) created at step 1 with a generated project ID; steps 2–8 are saved
// one by one into the master's step fields and the data file's `databaseTables`.
// ---------------------------------------------------------------------------------------------

model ReplantingProject {
  id                String    @id @db.Char(26)
  /// Generated: RP-<year>-<nnn>.
  projectCode       String    @unique @map("project_code") @db.VarChar(20)
  // Step 1 Project Information
  projectName       String    @map("project_name") @db.VarChar(255)
  estate            String    @map("estate_id") @db.Char(26)
  division          String    @map("division_id") @db.Char(26)
  section           String    @map("section_id") @db.Char(26)
  fieldBlock        String    @map("field_id") @db.Char(26)
  replantingType    String    @map("replant_type") @db.VarChar(60)
  season            String?   @db.VarChar(60)
  surveyDate        DateTime  @map("survey_date") @db.Date
  targetDate        DateTime? @map("target_date") @db.Date
  supervisor        String?   @db.VarChar(255)
  remarks           String?   @db.Text
  // Step 2 Gap Survey Entry
  gapSurveyDate     DateTime? @map("gap_survey_date") @db.Date
  surveyBy          String?   @map("survey_by") @db.VarChar(255)
  // Step 4 Material Planning
  plantVariety      String?   @map("plant_variety") @db.VarChar(60)
  planningDate      DateTime? @map("planning_date") @db.Date
  store             String?   @db.VarChar(100)
  preparedBy        String?   @map("prepared_by") @db.VarChar(255)
  materialRemarks   String?   @map("material_remarks") @db.Text
  // Step 5 Labour Allocation
  labourSource      String?   @map("labour_source") @db.VarChar(60)
  wageType          String?   @map("wage_type") @db.VarChar(60)
  // Step 6 Planting Entry
  plantingDate      DateTime? @map("planting_date") @db.Date
  cloneVariety      String?   @map("clone_variety") @db.VarChar(60)
  // Step 7 Progress Monitoring
  tillDate          DateTime? @map("till_date") @db.Date
  // Step 8 Completion
  completionDate    DateTime? @map("completion_date") @db.Date
  survival90Days    Decimal?  @map("survival_90_days") @db.Decimal(5, 2)
  completionRemarks String?   @map("completion_remarks") @db.Text
  /// The highest step saved (1–8).
  lastStep          Int       @default(1) @map("last_step")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by") @db.Char(26)
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String    @map("updated_by") @db.Char(26)
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by") @db.Char(26)

  estateRef    Estate                  @relation(fields: [estate], references: [id])
  fieldRef     FieldBlock              @relation(fields: [fieldBlock], references: [id])
  gaps         ReplantingGap[]
  preparation  ReplantingPreparation[]
  materials    ReplantingMaterial[]
  labour       ReplantingLabour[]
  plantingRows ReplantingPlantingRow[]
  progress     ReplantingProgress[]
  approvals    ReplantingApproval[]

  @@index([estate])
  @@index([deletedAt, createdAt])
  @@map("replanting_master")
}

/// Step 2 gap rows: gapId, gapSize (acre), plants, gapType.
model ReplantingGap {
  id           String  @id @db.Char(26)
  replantingId String  @map("replanting_id") @db.Char(26)
  position     Int
  gapId        String  @map("gap_id") @db.VarChar(60)
  gapSize      Decimal @map("gap_size") @db.Decimal(10, 2)
  plants       Int     @map("no_of_plants")
  gapType      String  @map("gap_type") @db.VarChar(40)
  location     String? @db.VarChar(255)
  status       String? @db.VarChar(40)

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_gap_details")
}

/// Step 3 land preparation activities.
model ReplantingPreparation {
  id           String   @id @db.Char(26)
  replantingId String   @map("replanting_id") @db.Char(26)
  position     Int
  activity     String   @db.VarChar(100)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  status       String   @db.VarChar(40)

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_land_preparation")
}

/// Step 4 materials; totalCost = requiredQty × unitCost.
model ReplantingMaterial {
  id           String  @id @db.Char(26)
  replantingId String  @map("replanting_id") @db.Char(26)
  position     Int
  material     String  @map("material_name") @db.VarChar(100)
  unit         String  @db.VarChar(20)
  requiredQty  Decimal @map("required_qty") @db.Decimal(12, 2)
  unitCost     Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost    Decimal @map("total_cost") @db.Decimal(14, 2)

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_material")
}

/// Step 5 labour; amount = (male + female) × rate.
model ReplantingLabour {
  id           String  @id @db.Char(26)
  replantingId String  @map("replanting_id") @db.Char(26)
  position     Int
  labourType   String  @map("labour_type") @db.VarChar(60)
  male         Int     @map("male_qty")
  female       Int     @map("female_qty")
  rate         Decimal @db.Decimal(10, 2)
  amount       Decimal @db.Decimal(14, 2)

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_labour")
}

/// Step 6 planting rows; plants = toPlant − fromPlant + 1.
model ReplantingPlantingRow {
  id           String  @id @db.Char(26)
  replantingId String  @map("replanting_id") @db.Char(26)
  position     Int
  rowNo        Int     @map("row_no")
  fromPlant    Int     @map("from_plant")
  toPlant      Int     @map("to_plant")
  plants       Int
  plantedBy    String? @map("planted_by") @db.VarChar(100)

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_planting_rows")
}

/// Step 7 progress rows.
model ReplantingProgress {
  id            String   @id @db.Char(26)
  replantingId  String   @map("replanting_id") @db.Char(26)
  position      Int
  date          DateTime @map("progress_date") @db.Date
  areaCompleted Decimal  @map("area_completed") @db.Decimal(10, 2)
  plantsPlanted Int      @map("plants_planted")
  survival      Decimal? @map("survival_percent") @db.Decimal(5, 2)
  remarks       String?  @db.Text

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_progress")
}

/// Step 8 approval levels (saved as data; the approval workflow is RP1-L).
model ReplantingApproval {
  id           String    @id @db.Char(26)
  replantingId String    @map("replanting_id") @db.Char(26)
  position     Int
  level        String    @db.VarChar(60)
  name         String?   @map("approved_by") @db.VarChar(255)
  designation  String?   @db.VarChar(60)
  status       String    @db.VarChar(20)
  date         DateTime? @map("approved_date") @db.Date
  /// Uploaded signature file id (RP1-10).
  signature    String?   @map("signature_path") @db.Char(26)
  remarks      String?   @db.Text

  project ReplantingProject @relation(fields: [replantingId], references: [id], onDelete: Cascade)

  @@index([replantingId, position])
  @@map("replanting_approval")
}

// ---------------------------------------------------------------------------------------------
// RP1-20 B.4 Plant Census (PlantCensus.jsx, plantCensusData.js). The census form, its row-wise table
// (rowWiseTable) and photo / document file ids. Approval waits for RP1-L.
// ---------------------------------------------------------------------------------------------

model PlantCensus {
  id                String    @id @db.Char(26)
  estate            String    @map("estate_id") @db.Char(26)
  division          String    @map("division_id") @db.Char(26)
  section           String    @map("section_id") @db.Char(26)
  fieldBlock        String    @map("field_id") @db.Char(26)
  censusDate        DateTime  @map("census_date") @db.Date
  censusYear        Int       @map("census_year")
  /// full | sample | random
  surveyType        String    @map("survey_type") @db.VarChar(40)
  rowFrom           Int       @map("row_from")
  rowTo             Int       @map("row_to")
  /// rowTo − rowFrom + 1
  totalSelectedRows Int       @map("total_selected_rows")
  /// ft
  rowSpacing        Decimal   @map("row_spacing") @db.Decimal(6, 2)
  plantingYear      Int       @map("planting_year")
  cloneVariety      String    @map("clone_variety") @db.VarChar(60)
  /// ft
  elevation         Decimal?  @db.Decimal(10, 2)
  /// ft
  plantSpacing      Decimal   @map("plant_spacing") @db.Decimal(6, 2)
  censusBy          String    @map("census_by") @db.VarChar(255)
  supervisor        String    @db.VarChar(60)
  /// manual | mobile-app | gps | drone
  censusMethod      String    @map("census_method") @db.VarChar(40)
  remarks           String?   @db.Text
  /// Uploaded file ids (RP1-10).
  photos            Json
  documents         Json
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by") @db.Char(26)
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String    @map("updated_by") @db.Char(26)
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by") @db.Char(26)

  estateRef Estate           @relation(fields: [estate], references: [id])
  fieldRef  FieldBlock       @relation(fields: [fieldBlock], references: [id])
  rows      PlantCensusRow[]

  @@index([estate, censusYear])
  @@index([fieldBlock])
  @@index([deletedAt, createdAt])
  @@map("plant_censuses")
}

/// rowWiseTable row: rowNo, rowLength (m), plantsPerMeter, expectedPlants, live, dead, missing, gap %.
model PlantCensusRow {
  id             String  @id @db.Char(26)
  censusId       String  @map("census_id") @db.Char(26)
  position       Int
  rowNo          String  @map("row_no") @db.VarChar(20)
  rowLength      Decimal @map("row_length") @db.Decimal(10, 2)
  plantsPerMeter Decimal @map("plants_per_meter") @db.Decimal(6, 2)
  expectedPlants Int     @map("expected_plants")
  livePlants     Int     @map("live_plants")
  deadPlants     Int     @map("dead_plants")
  missingPlants  Int     @map("missing_plants")
  /// (dead + missing) ÷ expected × 100, worked out on save.
  gapPercentage  Decimal @map("gap_percentage") @db.Decimal(6, 2)

  census PlantCensus @relation(fields: [censusId], references: [id], onDelete: Cascade)

  @@index([censusId, position])
  @@map("plant_census_rows")
}

/// RP1-21 B.5 Bush Register (`BushRegister.jsx`): one survey of a field block's bushes. The row table is
/// `BushRegisterRow`; the small / medium / large gap counts feed "Gap Size Wise Details" (not on the form).
model BushRegister {
  id             String    @id @db.Char(26)
  estate         String    @map("estate_id") @db.Char(26)
  division       String    @map("division_id") @db.Char(26)
  section        String    @map("section_id") @db.Char(26)
  fieldBlock     String    @map("field_id") @db.Char(26)
  plantingYear   Int       @map("planting_year")
  /// years
  bushAge        Int       @map("bush_age")
  /// acre
  totalArea      Decimal   @map("total_area") @db.Decimal(12, 2)
  /// ft
  rowSpacing     Decimal   @map("row_spacing") @db.Decimal(6, 2)
  /// ft
  plantSpacing   Decimal   @map("plant_spacing") @db.Decimal(6, 2)
  surveyDate     DateTime  @map("survey_date") @db.Date
  surveyor       String    @db.VarChar(255)
  /// active | productive | under-maintenance | replant-required | inactive
  bushStatus     String    @map("bush_status") @db.VarChar(40)
  /// excellent | good | fair | poor | dead
  bushHealth     String    @map("bush_health") @db.VarChar(40)
  productionZone String    @map("production_zone") @db.VarChar(40)
  rowDirection   String    @map("row_direction") @db.VarChar(40)
  smallGaps      Int?      @map("small_gaps")
  mediumGaps     Int?      @map("medium_gaps")
  largeGaps      Int?      @map("large_gaps")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String    @map("created_by") @db.Char(26)
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String    @map("updated_by") @db.Char(26)
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Char(26)

  estateRef Estate            @relation(fields: [estate], references: [id])
  fieldRef  FieldBlock        @relation(fields: [fieldBlock], references: [id])
  rows      BushRegisterRow[]

  @@index([estate, surveyDate])
  @@index([fieldBlock])
  @@index([deletedAt, createdAt])
  @@map("bush_registers")
}

/// `bushRegisterList`: one row of bushes. gap = (dead + missing) ÷ totalBush × 100; height / spread in cm.
model BushRegisterRow {
  id         String       @id @db.Char(26)
  registerId String       @map("register_id") @db.Char(26)
  rowNo      String       @map("row_no") @db.VarChar(20)
  from       Int          @map("from_bush")
  to         Int          @map("to_bush")
  totalBush  Int          @map("total_bush")
  productive Int
  dead       Int
  missing    Int
  gap        Decimal      @db.Decimal(5, 2)
  height     Decimal?     @db.Decimal(6, 2)
  spread     Decimal?     @db.Decimal(6, 2)
  /// Excellent | Good | Fair | Poor | Dead
  health     String?      @db.VarChar(20)
  remarks    String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  register   BushRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([registerId, rowNo])
  @@map("bush_register_rows")
}

/// RP1-22 C.1 Add New Employee (`AddNewEmployee.jsx` / `addNewEmployeeData.js`): every form field by its `name`.
/// Select fields keep the page's option values; files are uploaded file ids (RP1-10).
model Employee {
  id                       String    @id @db.Char(26)
  /// EMP-0001, generated
  employeeId               String    @map("employee_id") @db.VarChar(20)
  employeeType             String    @map("employee_type") @db.VarChar(60)
  title                    String    @db.VarChar(20)
  firstName                String    @map("first_name") @db.VarChar(255)
  middleName               String?   @map("middle_name") @db.VarChar(255)
  lastName                 String    @map("last_name") @db.VarChar(255)
  fatherName               String    @map("father_name") @db.VarChar(255)
  motherName               String    @map("mother_name") @db.VarChar(255)
  dateOfBirth              DateTime  @map("date_of_birth") @db.Date
  gender                   String    @db.VarChar(20)
  bloodGroup               String?   @map("blood_group") @db.VarChar(20)
  maritalStatus            String?   @map("marital_status") @db.VarChar(20)
  nationality              String    @db.VarChar(60)
  religion                 String?   @db.VarChar(60)
  tinNo                    String?   @map("tin_no") @db.VarChar(60)
  nationalIdNo             String?   @map("national_id_no") @db.VarChar(60)
  passportNo               String?   @map("passport_no") @db.VarChar(60)
  drivingLicenseNo         String?   @map("driving_license_no") @db.VarChar(60)
  department               String    @db.VarChar(60)
  designation              String    @db.VarChar(60)
  jobGrade                 String?   @map("job_grade") @db.VarChar(60)
  employmentDate           DateTime  @map("employment_date") @db.Date
  probationEndDate         DateTime? @map("probation_end_date") @db.Date
  confirmationDate         DateTime? @map("confirmation_date") @db.Date
  employmentType           String    @map("employment_type") @db.VarChar(60)
  workingLocation          String    @map("working_location") @db.VarChar(60)
  jobNature                String?   @map("job_nature") @db.VarChar(60)
  reportingTo              String    @map("reporting_to") @db.VarChar(60)
  numberOfDependents       Int       @map("number_of_dependents")
  employeeStatus           String    @map("employee_status") @db.VarChar(60)
  mobileNo                 String    @map("mobile_no") @db.VarChar(20)
  email                    String?   @db.VarChar(160)
  personalEmail            String?   @map("personal_email") @db.VarChar(160)
  presentAddress           String    @map("present_address") @db.Text
  permanentAddress         String    @map("permanent_address") @db.Text
  sameAsPermanentAddress   Boolean   @map("same_as_permanent_address")
  district                 String    @db.VarChar(60)
  upazila                  String    @db.VarChar(60)
  postalCode               String?   @map("postal_code") @db.VarChar(20)
  basicSalary              Decimal   @map("basic_salary") @db.Decimal(12, 2)
  houseRent                Decimal?  @map("house_rent") @db.Decimal(12, 2)
  medicalAllowance         Decimal?  @map("medical_allowance") @db.Decimal(12, 2)
  conveyance               Decimal?  @db.Decimal(12, 2)
  otherAllowance           Decimal?  @map("other_allowance") @db.Decimal(12, 2)
  /// basicSalary + houseRent + medicalAllowance + conveyance + otherAllowance (worked out by the server)
  totalSalary              Decimal   @map("total_salary") @db.Decimal(12, 2)
  paymentMethod            String    @map("payment_method") @db.VarChar(60)
  bankName                 String    @map("bank_name") @db.VarChar(60)
  accountNo                String    @map("account_no") @db.VarChar(60)
  remarks                  String?   @db.Text
  nationalIdFront          String?   @map("national_id_front") @db.Char(26)
  nationalIdBack           String?   @map("national_id_back") @db.Char(26)
  passportPhoto            String?   @map("passport_photo") @db.Char(26)
  educationalCertificate   String?   @map("educational_certificate") @db.Char(26)
  experienceCertificate    String?   @map("experience_certificate") @db.Char(26)
  otherDocument            String?   @map("other_document") @db.Char(26)
  employeePhoto            String?   @map("employee_photo") @db.Char(26)
  employeeFace             String?   @map("employee_face") @db.Char(26)
  rightThumb               String?   @map("right_thumb") @db.Char(26)
  leftThumb                String?   @map("left_thumb") @db.Char(26)
  emergencyContactName     String    @map("emergency_contact_name") @db.VarChar(255)
  emergencyRelation        String    @map("emergency_relation") @db.VarChar(20)
