/// RP1-23 C.2 Add New Worker (`AddNewWorker.jsx` / `addNewWorkerData.js`): every form field by its `name`;
/// `landDetails` and `dependents` are the two tables on the form. Files are uploaded file ids (RP1-10).
/// NID front / back are required by the form but empty for workers imported from a spreadsheet (RP1-24).
model Worker {
  id                   String    @id @db.Char(26)
  /// WRK-10001, generated
  workerId             String    @map("worker_id") @db.VarChar(20)
  workerType           String    @map("worker_type") @db.VarChar(60)
  category             String    @db.VarChar(60)
  title                String?   @db.VarChar(20)
  firstName            String    @map("first_name") @db.VarChar(255)
  middleName           String?   @map("middle_name") @db.VarChar(255)
  lastName             String    @map("last_name") @db.VarChar(255)
  fathersName          String    @map("fathers_name") @db.VarChar(255)
  mothersName          String    @map("mothers_name") @db.VarChar(255)
  dateOfBirth          DateTime  @map("date_of_birth") @db.Date
  gender               String    @db.VarChar(20)
  bloodGroup           String?   @map("blood_group") @db.VarChar(20)
  maritalStatus        String    @map("marital_status") @db.VarChar(20)
  nationality          String    @db.VarChar(60)
  religion             String    @db.VarChar(60)
  tinNo                String?   @map("tin_no") @db.VarChar(60)
  gardenUnit           String    @map("garden_unit") @db.VarChar(60)
  section              String    @db.VarChar(60)
  jobTask              String    @map("job_task") @db.VarChar(60)
  workerStatus         String    @map("worker_status") @db.VarChar(60)
  joinDate             DateTime  @map("join_date") @db.Date
  employmentType       String?   @map("employment_type") @db.VarChar(60)
  jobNature            String?   @map("job_nature") @db.VarChar(60)
  numberOfDependents   Int       @map("number_of_dependents")
  reportingTo          String?   @map("reporting_to") @db.VarChar(60)
  workingLocation      String?   @map("working_location") @db.VarChar(60)
  employmentStatus     String?   @map("employment_status") @db.VarChar(60)
  probationEndDate     DateTime? @map("probation_end_date") @db.Date
  mobileNo             String    @map("mobile_no") @db.VarChar(20)
  alternateMobile      String?   @map("alternate_mobile") @db.VarChar(20)
  personalEmail        String?   @map("personal_email") @db.VarChar(160)
  presentAddress       String    @map("present_address") @db.Text
  permanentAddress     String    @map("permanent_address") @db.Text
  sameAsPresentAddress Boolean   @map("same_as_present_address")
  district             String    @db.VarChar(60)
  upazila              String    @db.VarChar(60)
  postalCode           String?   @map("postal_code") @db.VarChar(20)
  workerPhoto          String?   @map("worker_photo") @db.Char(26)
  face                 String?   @db.Char(26)
  rightThumb           String?   @map("right_thumb") @db.Char(26)
  leftThumb            String?   @map("left_thumb") @db.Char(26)
  /// yes | no
  landDistributed      String    @map("land_distributed") @db.VarChar(10)
  landType             String?   @map("land_type") @db.VarChar(60)
  /// acre
  totalLand            Decimal?  @map("total_land") @db.Decimal(10, 2)
  resonCardNo          String?   @map("reson_card_no") @db.VarChar(60)
  issueDate            DateTime? @map("issue_date") @db.Date
  validTill            DateTime? @map("valid_till") @db.Date
  reasonDealerOffice   String?   @map("reason_dealer_office") @db.VarChar(255)
  resonCardFile        String?   @map("reson_card_file") @db.Char(26)
  educationLevel       String?   @map("education_level") @db.VarChar(60)
  skillTraining        String?   @map("skill_training") @db.VarChar(60)
  languageKnown        String?   @map("language_known") @db.VarChar(60)
  experienceYear       Int?      @map("experience_year")
  emergencyContactName String?   @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactNo   String?   @map("emergency_contact_no") @db.VarChar(20)
  bankName             String?   @map("bank_name") @db.VarChar(255)
  accountNo            String?   @map("account_no") @db.VarChar(60)
  mobileBanking        String?   @map("mobile_banking") @db.VarChar(60)
  nidFront             String?   @map("nid_front") @db.Char(26)
  nidBack              String?   @map("nid_back") @db.Char(26)
  birthCertificate     String?   @map("birth_certificate") @db.Char(26)
  nomineeIdCard        String?   @map("nominee_id_card") @db.Char(26)
  trainingCertificate  String?   @map("training_certificate") @db.Char(26)
  otherDocument        String?   @map("other_document") @db.Char(26)
  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            String    @map("created_by") @db.Char(26)
  updatedAt            DateTime  @updatedAt @map("updated_at")
  updatedBy            String    @map("updated_by") @db.Char(26)
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by") @db.Char(26)

  landDetails WorkerLand[]
  dependents  WorkerDependent[]

  @@index([workerId])
  @@index([gardenUnit, section])
  @@index([workerStatus])
  @@index([deletedAt, createdAt])
  @@map("workers")
}

/// Distributed Agri Land table: plotBlockNo, mouza, area (acre), distributedDate.
model WorkerLand {
  id              String    @id @db.Char(26)
  workerId        String    @map("worker_id") @db.Char(26)
  position        Int
  plotBlockNo     String    @map("plot_block_no") @db.VarChar(60)
  mouza           String?   @db.VarChar(120)
  area            Decimal   @db.Decimal(10, 2)
  distributedDate DateTime? @map("distributed_date") @db.Date
  worker          Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_lands")
}

/// Dependent Family Member table: name, relation, dateOfBirth, occupation.
model WorkerDependent {
  id          String    @id @db.Char(26)
  workerId    String    @map("worker_id") @db.Char(26)
  position    Int
  name        String    @db.VarChar(255)
  relation    String    @db.VarChar(40)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  occupation  String?   @db.VarChar(120)
  worker      Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_dependents")
}

