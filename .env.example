# Copy to .env for running with `npm run dev` on your machine.
# Docker (`docker compose up`) does not need this file: docker-compose.yml sets everything.

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# MySQL from `docker compose up -d mysql` (published on host port 3307).
DATABASE_URL=mysql://root:rupai_root_dev@127.0.0.1:3307/rupai_p1
# Only for `npm run migrate:new` / `migrate:dev` (creating migrations).
SHADOW_DATABASE_URL=mysql://root:rupai_root_dev@127.0.0.1:3307/rupai_p1_shadow

# The dashboard (rupai-backend-dashboard) origins, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs the login tokens. Any long random string (at least 32 characters).
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7

# Uploaded files and the address used in file links.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
PUBLIC_URL=http://localhost:4100
