{
  "name": "rupai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RupAI Phase 1 backend for the rupai-backend-dashboard (Jira RP1)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:new": "prisma migrate dev --create-only",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed/index.ts",
    "db:up": "docker compose up -d --wait mysql"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "busboy": "^1.6.0",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "^5.0.1",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/busboy": "^1.5.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
